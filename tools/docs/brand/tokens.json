{
  "$description": "Odys brand tokens: the single source of truth for colours and fonts. tools/docs/generate_brand.py turns this into docs/assets/stylesheets/brand.css (every colour becomes --odys-<name>); tools/docs/generate_example_plots.py reads the chart palette directly. Edit here, then run `just docs-assets`.",
  "color": {
    "bg": "#0a0e1a",
    "bg-deep": "#070a12",
    "bg-raised": "#0d1220",
    "surface": "#0f1524",
    "surface-thumb": "#0b1020",
    "node-violet": "#1a2340",
    "node-mint": "#13302a",
    "line-faint": "#161f33",
    "line": "#1f2a40",
    "line-strong": "#2a3654",
    "line-hover": "#3a4a6e",
    "axis": "#26324a",
    "text": "#f2f5fa",
    "text-soft": "#c2cada",
    "muted": "#9aa6bc",
    "muted-deep": "#4a5675",
    "violet-200": "#cdd3ff",
    "violet-300": "#a5b0ff",
    "violet-400": "#7c8cff",
    "violet-500": "#5e7be0",
    "violet-600": "#4c5bd4",
    "violet-700": "#3f4dc4",
    "mint-400": "#5eeaa0",
    "mint-700": "#0b7a4b",
    "mint-ink": "#06231a",
    "amber-300": "#ffc27a",
    "code": "#e3e8f2",
    "code-class": "#b4bcff",
    "code-kwarg": "#8fd3ff",
    "code-punct": "#7d88a0",
    "code-comment": "#8b96ad",
    "code-error": "#ff9c9c",
    "paper": "#ffffff",
    "paper-code": "#f4f5fb",
    "ink-text": "#1e2433",
    "ink-muted": "#5b6478"
  },
  "scheme": {
    "dark": {
      "background": "bg",
      "foreground": "text",
      "foreground-muted": "muted",
      "header": "bg",
      "header-text": "text",
      "link": "violet-300",
      "accent": "mint-400",
      "code-background": "surface",
      "code-foreground": "code"
    },
    "light": {
      "background": "paper",
      "foreground": "ink-text",
      "foreground-muted": "ink-muted",
      "header": "violet-600",
      "header-text": "paper",
      "link": "violet-600",
      "accent": "mint-700",
      "code-background": "paper-code",
      "code-foreground": "ink-text"
    }
  },
  "font": {
    "sans": {
      "family": "Mona Sans",
      "fallback": "system-ui, sans-serif",
      "weights": [
        400,
        500,
        600,
        700,
        800
      ],
      "widths": [
        100,
        125
      ]
    },
    "mono": {
      "family": "Source Code Pro",
      "fallback": "ui-monospace, monospace",
      "weights": [
        400,
        500,
        700
      ]
    },
    "math": {
      "family": "STIX Two Text",
      "fallback": "serif",
      "italic": true
    }
  },
  "chart": {
    "$description": "Colours for the example pages' Plotly charts, which render on a transparent background and follow the docs colour scheme. Hue follows energy conventions (solar is gold, thermal is warm); storage takes the brand violet and money the brand mint. Each role has a light and a dark value. Every value reaches 3:1 on its scheme's background, except roles marked `fill`, which are only used for areas: next to a darker line of the same hue, or behind text. One light value always maps to one dark value. `chrome` holds the non-data colours: text, gridlines, axes and the background used for bar outlines and hover labels.",
    "roles": {
      "solar": {
        "light": "#f0b114",
        "dark": "#f0b114",
        "fill": true
      },
      "solar_line": {
        "light": "#9a6700",
        "dark": "#f0b114"
      },
      "thermal": {
        "light": "#c4552b",
        "dark": "#e0784f"
      },
      "load": {
        "light": "#1e2433",
        "dark": "#c2cada"
      },
      "battery_soc": {
        "light": "#2b3591",
        "dark": "#cdd3ff"
      },
      "discharge": {
        "light": "#4c5bd4",
        "dark": "#7c8cff"
      },
      "charge": {
        "light": "#a5b0ff",
        "dark": "#a5b0ff",
        "fill": true
      },
      "market_buy": {
        "light": "#6b7a90",
        "dark": "#9aa6bc"
      },
      "price": {
        "light": "#0f8a55",
        "dark": "#5eeaa0"
      },
      "sdac": {
        "light": "#2f5a9e",
        "dark": "#6f9be0"
      },
      "sidc": {
        "light": "#0b8fc7",
        "dark": "#4cc3f0"
      },
      "flexible_load": {
        "light": "#0b8fc7",
        "dark": "#4cc3f0"
      },
      "value_of_consumption": {
        "light": "#c2417a",
        "dark": "#f07aaa"
      },
      "ev_1": {
        "light": "#0f8a55",
        "dark": "#5eeaa0"
      },
      "ev_2": {
        "light": "#c2417a",
        "dark": "#f07aaa"
      },
      "ev_3": {
        "light": "#0b8fc7",
        "dark": "#4cc3f0"
      },
      "price_step": {
        "light": "#5b6478",
        "dark": "#9aa6bc"
      },
      "trip": {
        "light": "#858e9e",
        "dark": "#858e9e"
      },
      "marker_outline": {
        "light": "#1e2433",
        "dark": "#c2cada"
      },
      "table_header": {
        "light": "#eceff4",
        "dark": "#1f2a40",
        "fill": true
      },
      "check_ok": {
        "light": "#1b7f4a",
        "dark": "#5eeaa0"
      },
      "check_fail": {
        "light": "#c23b2e",
        "dark": "#ff9c9c"
      }
    },
    "chrome": {
      "text": {
        "light": "#1e2433",
        "dark": "#c2cada"
      },
      "muted": {
        "light": "#5b6478",
        "dark": "#9aa6bc"
      },
      "grid": {
        "light": "#e3e6ee",
        "dark": "#1f2a40"
      },
      "axis": {
        "light": "#c9ced9",
        "dark": "#2a3654"
      },
      "background": {
        "light": "#ffffff",
        "dark": "#0a0e1a"
      }
    }
  }
}
