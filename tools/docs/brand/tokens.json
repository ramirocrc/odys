{
  "$description": "Odys brand tokens: the single source of truth for colours and fonts. tools/docs/generate_brand.py turns this into docs/assets/stylesheets/brand.css (every colour becomes --odys-<name>); tools/docs/generate_example_plots.py reads the chart palette directly. Edit here, then run `just docs-assets`.",
  "color": {
    "bg": "#0a0e1a",
    "text": "#f2f5fa",
    "violet-200": "#cdd3ff",
    "violet-300": "#a5b0ff",
    "violet-500": "#5e7be0",
    "violet-600": "#4c5bd4",
    "violet-700": "#3f4dc4",
    "mint-400": "#5eeaa0",
    "mint-700": "#0b7a4b",
    "paper": "#ffffff",
    "gray-50": "#f1f1f1",
    "gray-100": "#e8e8e8",
    "gray-150": "#e5e5e5",
    "gray-200": "#e1e1e1",
    "gray-300": "#b8b8b8",
    "gray-400": "#979797",
    "gray-500": "#767676",
    "gray-600": "#484848",
    "gray-700": "#3a3a3a",
    "gray-750": "#363636",
    "gray-800": "#2f2f2f",
    "gray-900": "#1a1a1a",
    "green-400": "#42d392",
    "green-500": "#42b883",
    "blue-400": "#647eff",
    "indigo-200": "#aac8e4",
    "indigo-600": "#476582",
    "indigo-900": "#213547"
  },
  "scheme": {
    "dark": {
      "background": "gray-900",
      "foreground": "gray-200",
      "foreground-muted": "gray-400",
      "header": "gray-900",
      "header-text": "gray-200",
      "link": "violet-300",
      "accent": "green-500",
      "code-background": "gray-800",
      "code-foreground": "gray-200"
    },
    "light": {
      "background": "paper",
      "foreground": "indigo-900",
      "foreground-muted": "gray-500",
      "header": "paper",
      "header-text": "indigo-900",
      "link": "violet-600",
      "accent": "mint-700",
      "code-background": "gray-50",
      "code-foreground": "indigo-900"
    }
  },
  "font": {
    "sans": {
      "family": "Mona Sans",
      "fallback": "system-ui, sans-serif",
      "weights": [
        400,
        500,
        600,
        700,
        800,
        900
      ],
      "widths": [
        100,
        125
      ]
    },
    "mono": {
      "family": "Source Code Pro",
      "fallback": "ui-monospace, monospace",
      "weights": [
        400,
        500,
        700
      ]
    },
    "ui": {
      "family": "Inter",
      "fallback": "-apple-system, \"Segoe UI\", Roboto, sans-serif",
      "weights": [
        500,
        600
      ]
    },
    "math": {
      "family": "STIX Two Text",
      "fallback": "serif",
      "italic": true
    }
  },
  "chart": {
    "$description": "Colours for the example pages' Plotly charts, which render on a transparent background and follow the docs colour scheme. Hue follows energy conventions (solar is gold, thermal is warm); storage takes the brand violet and money the brand mint. Each role has a light and a dark value. Every value reaches 3:1 on its scheme's background, except roles marked `fill`, which are only used for areas: next to a darker line of the same hue, or behind text. One light value always maps to one dark value. `chrome` holds the non-data colours: text, gridlines, axes and the background used for bar outlines and hover labels.",
    "roles": {
      "solar": {
        "light": "#f0b114",
        "dark": "#f0b114",
        "fill": true
      },
      "solar_line": {
        "light": "#9a6700",
        "dark": "#f0b114"
      },
      "thermal": {
        "light": "#c4552b",
        "dark": "#e0784f"
      },
      "load": {
        "light": "#1e2433",
        "dark": "#c2cada"
      },
      "battery_soc": {
        "light": "#2b3591",
        "dark": "#cdd3ff"
      },
      "discharge": {
        "light": "#4c5bd4",
        "dark": "#7c8cff"
      },
      "charge": {
        "light": "#a5b0ff",
        "dark": "#a5b0ff",
        "fill": true
      },
      "market_buy": {
        "light": "#6b7a90",
        "dark": "#9aa6bc"
      },
      "price": {
        "light": "#0f8a55",
        "dark": "#5eeaa0"
      },
      "sdac": {
        "light": "#2f5a9e",
        "dark": "#6f9be0"
      },
      "sidc": {
        "light": "#0b8fc7",
        "dark": "#4cc3f0"
      },
      "flexible_load": {
        "light": "#0b8fc7",
        "dark": "#4cc3f0"
      },
      "value_of_consumption": {
        "light": "#c2417a",
        "dark": "#f07aaa"
      },
      "ev_1": {
        "light": "#0f8a55",
        "dark": "#5eeaa0"
      },
      "ev_2": {
        "light": "#c2417a",
        "dark": "#f07aaa"
      },
      "ev_3": {
        "light": "#0b8fc7",
        "dark": "#4cc3f0"
      },
      "price_step": {
        "light": "#5b6478",
        "dark": "#9aa6bc"
      },
      "trip": {
        "light": "#858e9e",
        "dark": "#858e9e"
      },
      "marker_outline": {
        "light": "#1e2433",
        "dark": "#c2cada"
      },
      "table_header": {
        "light": "#f1f1f1",
        "dark": "#2f2f2f",
        "fill": true
      },
      "check_ok": {
        "light": "#1b7f4a",
        "dark": "#5eeaa0"
      },
      "check_fail": {
        "light": "#c23b2e",
        "dark": "#ff9c9c"
      }
    },
    "chrome": {
      "text": {
        "light": "#213547",
        "dark": "#e1e1e1"
      },
      "muted": {
        "light": "#767676",
        "dark": "#979797"
      },
      "grid": {
        "light": "#e8e8e8",
        "dark": "#2f2f2f"
      },
      "axis": {
        "light": "#b8b8b8",
        "dark": "#484848"
      },
      "background": {
        "light": "#ffffff",
        "dark": "#1a1a1a"
      }
    }
  }
}
